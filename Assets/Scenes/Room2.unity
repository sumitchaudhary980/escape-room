  narrationLines:
  - subtitle: Welcome to the Escape Room.
    duration: 1.4
  - subtitle: Your goal is to escape by solving puzzles across different rooms.
    duration: 1.6
  - subtitle: There are 6 hidden notes placed throughout the environment.
    duration: 1.5
  - subtitle: Each note contains a different clue.
    duration: 0.8
  - subtitle: The first digit of each note is part of the final keypad code.
    duration: 1.8
  - subtitle: Collect all six digits to unlock the final door.
    duration: 2
  - subtitle: "Search carefully\u2026 nothing is placed without purpose"
    duration: 1.8
  - subtitle: Good luck.
    duration: 0.5
